# --- Database (dipakai backend & docker-compose) ---
POSTGRES_USER=kdo
POSTGRES_PASSWORD=kdo_secret
POSTGRES_DB=kdo
POSTGRES_PORT=5432
DATABASE_URL=postgres://kdo:kdo_secret@localhost:5432/kdo
# Database terpisah untuk `bun test` (dibuat otomatis oleh docker/postgres/init.sql)
TEST_DATABASE_URL=postgres://kdo:kdo_secret@localhost:5432/kdo_test

# --- Backend ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
TZ=Asia/Jakarta

# --- Frontend (dibaca Vite saat build) ---
VITE_API_URL=http://localhost:3000/api/v1
